# Variáveis de Ambiente da Plataforma TM-Educa

# Conexão com a Base de Dados PostgreSQL
# Opção A: Desenvolvimento Local (PostgreSQL local)
DATABASE_URL="postgresql://postgres:9900@localhost:5432/tm_educa?schema=public"
DIRECT_URL="postgresql://postgres:9900@localhost:5432/tm_educa?schema=public"

# Opção B: Produção / Cloud (Neon Serverless PostgreSQL)
# DATABASE_URL="postgresql://neondb_owner:senha@ep-xxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://neondb_owner:senha@ep-xxx.regiao.aws.neon.tech/neondb?sslmode=require"

# Autenticação (NextAuth.js v5)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="chave_secreta_para_desenvolvimento_tm_educa_minimo_32_caracteres"

# Ambiente
NODE_ENV="development"

# Configuração de Correio Eletrónico (E-mail de Boas-Vindas & Recuperação de Senha)
# Opção 1: Servidor SMTP Oficial TM-Educa
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="tmeduca99@gmail.com"
SMTP_PASS="sua_senha_de_app_ou_smtp"
